enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @db.Uuid
  patient         Patient           @relation(fields: [patientId], references: [id])
  branchId        String            @db.Uuid
  branch          Branch            @relation(fields: [branchId], references: [id])
  orderId         String?           @unique @db.Uuid
  order           Order?            @relation(fields: [orderId], references: [id])
  doctorId        String?           @db.Uuid
  doctorProfile   DoctorProfile?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  phlebotomistId  String?           @db.Uuid
  phlebotomist    User?             @relation("AssignedPhlebotomist", fields: [phlebotomistId], references: [id])
  scheduledAt     DateTime          @db.Timestamptz
  durationMinutes Int               @default(15)
  status          AppointmentStatus @default(SCHEDULED)
  type            String            @default("LAB_TEST")
  notes           String?
  cancelReason    String?
  reminderSent    Boolean           @default(false)
  reminderSentAt  DateTime?         @db.Timestamptz
  checkedInAt     DateTime?         @db.Timestamptz
  completedAt     DateTime?         @db.Timestamptz
  noShowAt        DateTime?         @db.Timestamptz
  createdBy       String?           @db.Uuid
  updatedBy       String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  deletedAt       DateTime?         @db.Timestamptz

  @@index([branchId, scheduledAt])
  @@index([patientId, scheduledAt(sort: Desc)])
  @@index([status])
  @@index([phlebotomistId, scheduledAt])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@index([branchId, status, scheduledAt])
  @@map("appointments")
}

// --- Queue Management (from reception-schema, adapted for Prisma) ---

enum QueueServiceType {
  WALK_IN
  APPOINTMENT
  HOME_VISIT
  CONSULTATION
}

enum QueuePriority {
  NORMAL
  PRIORITY
  VIP
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  NO_SHOW
  CANCELLED
  TRANSFERRED
}

enum ServicePointType {
  COUNTER
  DESK
  VIP
  EMERGENCY
  CONSULTATION
}

enum ServicePointStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model QueueSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  branchId            String   @unique @db.Uuid
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  maxWaitTargetMinutes Int     @default(30)
  autoAssignEnabled   Boolean  @default(true)
  priorityBoostMinutes Int     @default(10)
  vipMaxWaitMinutes   Int      @default(5)
  emergencyOverride   Boolean  @default(true)
  announceOnScreen    Boolean  @default(true)
  announceAudio       Boolean  @default(true)
  ticketPrinterEnabled Boolean @default(true)
  operatingHours      Json?
  createdBy           String?  @db.Uuid
  updatedBy           String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt @db.Timestamptz

  @@map("queue_settings")
}

model QueueServicePoint {
  id                String            @id @default(uuid()) @db.Uuid
  branchId          String            @db.Uuid
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name              String
  type              ServicePointType  @default(COUNTER)
  status            ServicePointStatus @default(ACTIVE)
  currentEntryId    String?           @unique @db.Uuid
  currentEntry      QueueEntry?       @relation(fields: [currentEntryId], references: [id], onDelete: SetNull)
  assignedUserId    String?           @db.Uuid
  assignedUser      User?             @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  maxConcurrent     Int               @default(1)
  averageServiceMinutes Int           @default(15)
  createdBy         String?           @db.Uuid
  updatedBy         String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  @@index([branchId, status])
  @@index([assignedUserId])
  @@map("queue_service_points")
}

model QueueEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  ticketNumber        String          @unique // Q-001, O-001, P-001, V-001, E-001
  branchId            String          @db.Uuid
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  patientId           String?         @db.Uuid
  patient             Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName         String
  patientPhone        String?
  patientNationalId   String?
  serviceType         QueueServiceType @default(WALK_IN)
  priority            QueuePriority   @default(NORMAL)
  status              QueueStatus     @default(WAITING)
  servicePoint        String?
  phlebotomistId      String?         @db.Uuid
  calledAt            DateTime?       @db.Timestamptz
  startedServingAt    DateTime?       @db.Timestamptz
  completedAt         DateTime?       @db.Timestamptz
  estimatedWaitMinutes Int?
  actualWaitMinutes   Int?
  notes               String?
  createdBy           String?         @db.Uuid
  updatedBy           String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz
  updatedAt           DateTime        @updatedAt @db.Timestamptz

  servicePointEntry   QueueServicePoint?

  @@index([branchId, status])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([patientId])
  @@index([priority, createdAt])
  @@index([status, branchId, priority])
  @@index([ticketNumber])
  @@map("queue_entries")
}

model QueueHistory {
  id              String   @id @default(uuid()) @db.Uuid
  queueEntryId    String   @db.Uuid
  fromStatus      String
  toStatus        String
  servicePoint    String?
  performedById   String?  @db.Uuid
  notes           String?
  durationSeconds Int?
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@index([queueEntryId, createdAt])
  @@index([createdAt])
  @@map("queue_history")
}

// ============================================================================
// SECTION 9: INSURANCE
// ============================================================================

model InsuranceCompany {
  id                String   @id @default(uuid()) @db.Uuid
  nameAr            String
  nameEn            String
  code              String   @unique
  contactPhone      String
  contactEmail      String?
  claimsEmail       String?
  website           String?
  totalPatients     Int      @default(0)
  totalClaims       Int      @default(0)
  approvedClaims    Int      @default(0)
  rejectedClaims    Int      @default(0)
  avgProcessingDays Int      @default(7)
  isActive          Boolean  @default(true)
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz
  deletedAt         DateTime? @db.Timestamptz

  policies          InsurancePolicy[]
  verifications     InsuranceVerification[]
  claims            InsuranceClaim[]

  @@index([code])
  @@index([isActive, deletedAt])
  @@map("insurance_companies")
}

model InsurancePolicy {
  id                String            @id @default(uuid()) @db.Uuid
  patientId         String            @db.Uuid
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceCompanyId String           @db.Uuid
  insuranceCompany  InsuranceCompany  @relation(fields: [insuranceCompanyId], references: [id])
  policyNumber      String
  cardNumber        String?
  groupNumber       String?
  planType          String?
  coveragePercentage Float           @default(80)
  maxCoverage       Float?
  deductible        Float?            @default(0)
  startDate         DateTime          @db.Date
  endDate           DateTime          @db.Date
  isActive          Boolean           @default(true)
  isPrimary         Boolean           @default(true)
  dependents        Json?             // {spouse, children: [...]}
  notes             String?
  createdBy         String?           @db.Uuid
  updatedBy         String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz
  deletedAt         DateTime?         @db.Timestamptz

  verifications     InsuranceVerification[]
  claims            InsuranceClaim[]

  @@index([patientId])
  @@index([insuranceCompanyId])
  @@index([policyNumber])
  @@index([isActive, endDate])
  @@map("insurance_policies")
}

enum InsuranceVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  PARTIAL
}

model InsuranceVerification {
  id                  String                    @id @default(uuid()) @db.Uuid
  verificationNumber  String                    @unique
  branchId            String                    @db.Uuid
  branch              Branch                    @relation(fields: [branchId], references: [id])
  patientId           String                    @db.Uuid
  patient             Patient                   @relation(fields: [patientId], references: [id])
  policyId            String?                   @db.Uuid
  policy              InsurancePolicy?          @relation(fields: [policyId], references: [id])
  insuranceCompanyId  String?                   @db.Uuid
  insuranceCompany    InsuranceCompany?         @relation(fields: [insuranceCompanyId], references: [id])
  insuranceNumber     String
  verificationStatus  InsuranceVerificationStatus @default(PENDING)
  coveragePercentage  Float?
  coveredAmount       Float?
  totalAmount         Float?
  approvalCode        String?
  rejectionReason     String?
  verifiedAt          DateTime?                 @db.Timestamptz
  verifiedById        String?                   @db.Uuid
  apiResponse         Json?
  notes               String?
  createdBy           String?                   @db.Uuid
  updatedBy           String?                   @db.Uuid
  createdAt           DateTime                  @default(now()) @db.Timestamptz
  updatedAt           DateTime                  @updatedAt @db.Timestamptz

  @@index([branchId, createdAt(sort: Desc)])
  @@index([patientId])
  @@index([insuranceCompanyId])
  @@index([verificationStatus])
  @@index([verificationNumber])
  @@map("insurance_verifications")
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  APPEALED
  PAID
  CLOSED
}

model InsuranceClaim {
  id                String                @id @default(uuid()) @db.Uuid
  claimNumber       String                @unique
  patientId         String                @db.Uuid
  policyId          String                @db.Uuid
  policy            InsurancePolicy       @relation(fields: [policyId], references: [id])
  insuranceCompanyId String               @db.Uuid
  insuranceCompany  InsuranceCompany      @relation(fields: [insuranceCompanyId], references: [id])
  orderId           String?               @db.Uuid
  invoiceId         String?               @db.Uuid
  status            InsuranceClaimStatus  @default(DRAFT)
  submittedAmount   Float
  approvedAmount    Float?
  rejectedAmount    Float?
  rejectionReason   String?
  diagnosisCode     String?               // ICD-10
  diagnosisCodeAr   String?
  submittedAt       DateTime?             @db.Timestamptz
  reviewedAt        DateTime?             @db.Timestamptz
  paidAt            DateTime?             @db.Timestamptz
  documents         Json?
  notes             String?
  createdBy         String?               @db.Uuid
  updatedBy         String?               @db.Uuid
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz
  deletedAt         DateTime?             @db.Timestamptz

  @@index([claimNumber])
  @@index([patientId])
  @@index([policyId])
  @@index([insuranceCompanyId])
  @@index([status])
  @@index([submittedAt])
  @@index([createdAt])
  @@map("insurance_claims")
}

// ============================================================================
// SECTION 10: BILLING, INVOICES, PAYMENTS & REFUNDS
// ============================================================================

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique // INV-2024000001
  orderId         String        @unique @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id])
  patientId       String        @db.Uuid
  patient         Patient       @relation(fields: [patientId], references: [id])
  branchId        String?       @db.Uuid
  branch          Branch?       @relation(fields: [branchId], references: [id])
  subtotal        Float
  discount        Float         @default(0)
  tax             Float         @default(0)
  taxRate         Float         @default(15)
  total           Float
  paidAmount      Float         @default(0)
  balanceDue      Float         @default(0)
  currency        String        @default("SAR")
  status          PaymentStatus @default(PENDING)
  dueDate         DateTime?     @db.Date
  paidAt          DateTime?     @db.Timestamptz
  notes           String?
  zatcaQrCode     String?       // ZATCA compliant QR
  zatcaUuid       String?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz
  deletedAt       DateTime?     @db.Timestamptz

  payments        Payment[]
  refund          Refund?

  @@index([invoiceNumber])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([branchId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  paymentNumber   String        @unique // PAY-2024000001
  invoiceId       String        @db.Uuid
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Float
  currency        String        @default("SAR")
  method          PaymentMethod
  transactionId   String?       // Gateway transaction ID
  gatewayResponse Json?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @db.Timestamptz
  receiptUrl      String?
  cardLast4       String?
  cardBrand       String?
  bankReference   String?
  notes           String?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  @@index([invoiceId])
  @@index([transactionId])
  @@index([paymentNumber])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@map("payments")
}

model Refund {
  id              String        @id @default(uuid()) @db.Uuid
  refundNumber    String        @unique // REF-2024000001
  invoiceId       String        @unique @db.Uuid
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  orderId         String?       @unique @db.Uuid
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId       String?       @db.Uuid
  amount          Float
  reason          String
  reasonAr        String?
  status          PaymentStatus @default(PENDING)
  transactionId   String?       // Refund gateway transaction
  gatewayResponse Json?
  processedAt     DateTime?     @db.Timestamptz
  approvedById    String?       @db.Uuid
  notes           String?
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  @@index([refundNumber])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("refunds")
}

// ============================================================================
// SECTION 11: MEDICAL HISTORY
// ============================================================================

model MedicalHistory {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category        String   // allergy, condition, surgery, medication, family
  title           String
  titleAr         String?
  description     String?
  diagnosisCode   String?  // ICD-10
  severity        String?  // mild, moderate, severe
  onsetDate       DateTime? @db.Date
  resolvedDate    DateTime? @db.Date
  isChronic       Boolean  @default(false)
  isActive        Boolean  @default(true)
  recordedById    String?  @db.Uuid
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@index([patientId, category])
  @@index([patientId, isActive])
  @@index([category])
  @@map("medical_history")
}

// ============================================================================
// SECTION 12: COUPONS & OFFERS
// ============================================================================

model Coupon {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameAr      String?
  nameEn      String?
  type        String   @default("percentage") // percentage, fixed
  value       Float
  minOrder    Float    @default(0)
  maxDiscount Float?
  maxUses     Int      @default(-1) // -1 = unlimited
  usedCount   Int      @default(0)
  validFrom   DateTime @db.Timestamptz
