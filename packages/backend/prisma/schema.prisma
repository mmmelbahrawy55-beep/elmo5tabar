// ============================================================================
// AL MOKHTABAR LABORATORY - Enterprise PostgreSQL Schema
// ============================================================================
// Version: 2.0.0
// Target: Millions of patients, billions of records
// ORM: Prisma with PostgreSQL
// Features: UUID PKs, soft deletes, audit trails, partitioning-ready
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "multiSchema", "postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp, pgcrypto, pg_trgm]
}

// ============================================================================
// SECTION 1: AUTHENTICATION, ROLES & PERMISSIONS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  DOCTOR
  LAB_TECHNICIAN
  PHLEBOTOMIST
  NURSE
  RECEPTIONIST
  BILLING_STAFF
  MARKETING_STAFF
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// --- ROLES ---
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  nameAr      String?
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  permissions RolePermission[]
  users       User[]

  @@index([isActive])
  @@map("roles")
}

// --- PERMISSIONS ---
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   // e.g., "patients", "orders", "reports"
  action      String   // e.g., "create", "read", "update", "delete", "export"
  resource    String?  // Optional specific resource within module
  name        String   @unique // e.g., "patients:create", "reports:export"
  nameAr      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz

  roles       RolePermission[]

  @@index([module])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// --- USERS ---
model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique
  phone                String?   @unique
  passwordHash         String
  role                 UserRole  @default(PATIENT)
  status               UserStatus @default(PENDING_VERIFICATION)
  emailVerified        Boolean   @default(false)
  phoneVerified        Boolean   @default(false)
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  lastLoginAt          DateTime? @db.Timestamptz
  lastLoginIp          String?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime? @db.Timestamptz
  passwordChangedAt    DateTime? @db.Timestamptz
  preferredLanguage    String    @default("ar")
  timezone             String    @default("Asia/Riyadh")
  isActive             Boolean   @default(true)
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz
  deletedAt            DateTime? @db.Timestamptz

  profile              UserProfile?
  refreshToken         RefreshToken[]
  sessions             Session[]
  loginHistory         LoginHistory[]
  roleRelation         Role?        @relation(fields: [roleId], references: [id])
  roleId               String?      @db.Uuid
  doctorProfile        DoctorProfile?
  employeeProfile      EmployeeProfile?
  phlebotomistProfile  PhlebotomistProfile?
  ownedOrders          Order[]          @relation("OrderedBy")
  reviewedReports      Report[]         @relation("ReviewedBy")
  verifiedResults      Report[]         @relation("VerifiedBy")
  auditLogs            AuditLog[]
  activityLogs         ActivityLog[]
  notifications        Notification[]
  sentSmsLogs          SmsLog[]         @relation("SentBySms")
  sentEmailLogs        EmailLog[]       @relation("SentByEmail")
  sentWhatsAppLogs     WhatsAppLog[]    @relation("SentByWhatsApp")
  apiKeys              ApiKey[]
  managedBranches      Branch[]         @relation("BranchManager")
  assignedAppointments Appointment[]    @relation("AssignedPhlebotomist")
  queueServicePoints   QueueServicePoint[]
  createdEntities      SystemLog[]      @relation("SystemLogCreatedBy")
  patient              Patient?

  @@index([email])
  @@index([phone])
  @@index([role, status])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  isActive  Boolean  @default(true)
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstNameAr String
  lastNameAr  String
  firstNameEn String?
  lastNameEn  String?
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  nationality String?
  nationalId  String?   @unique
  avatar      String?
  address     String?
  city        String?
  region      String?
  country     String    @default("SA")
  bio         String?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@index([nationalId])
  @@map("user_profiles")
}

// ============================================================================
// SECTION 2: SESSIONS, DEVICES & LOGIN TRACKING
// ============================================================================

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceInfo   Json?
  location     String?
  isActive     Boolean  @default(true)
  lastActivityAt DateTime @db.Timestamptz
  expiresAt    DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  name         String   // e.g., "iPhone 15 Pro"
  type         String   // mobile, desktop, tablet
  os           String?  // iOS, Android, Windows, macOS
  browser      String?
  fingerprint  String?  @unique
  isTrusted    Boolean  @default(false)
  lastUsedAt   DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([fingerprint])
  @@map("devices")
}

model LoginHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  location     String?
  success      Boolean
  failureReason String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([success])
  @@index([createdAt])
  @@map("login_history")
}

// ============================================================================
// SECTION 3: PATIENTS & FAMILY MEMBERS
// ============================================================================

model Patient {
  id                String    @id @default(uuid()) @db.Uuid
  patientNumber     String    @unique // Sequential: P-2024000001
  userId            String?   @unique @db.Uuid
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstNameAr       String
  lastNameAr        String
  firstNameEn       String?
  lastNameEn        String?
  dateOfBirth       DateTime  @db.Date
  gender            Gender
  phone             String
  email             String?
  nationalId        String?   @unique
  passportNumber    String?
  nationality       String?
  bloodType         BloodType?
  allergies         String?
  chronicDiseases   String?
  medicalNotes      String?
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?
  referralSource    String?   // walk-in, online, doctor-referral, corporate
  isActive          Boolean   @default(true)
  isVip             Boolean   @default(false)
  vipTier           String?   // silver, gold, platinum, diamond
  totalVisits       Int       @default(0)
  lastVisitAt       DateTime? @db.Timestamptz
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz
  deletedAt         DateTime? @db.Timestamptz

  // Relations
  orders            Order[]
  reports           Report[]
  appointments      Appointment[]
  invoices          Invoice[]
  medicalHistory    MedicalHistory[]
  familyMembers     Patient[]          @relation("PatientFamily")
  parentPatient     Patient?           @relation("PatientFamily", fields: [parentPatientId], references: [id])
  parentPatientId   String?            @db.Uuid
  insurancePolicies InsurancePolicy[]
  queueEntries      QueueEntry[]
  homeVisits        HomeVisitRequest[]
  emergencyCases    EmergencyCase[]
  transfers         BranchTransfer[]
  supportTickets    SupportTicket[]
  barcodeJobs       BarcodePrintJob[]
  notifications     Notification[]
  insuranceVerifications InsuranceVerification[]
  vipMember         VipMember?

  @@index([patientNumber])
  @@index([nationalId])
  @@index([phone])
  @@index([email])
  @@index([dateOfBirth])
  @@index([gender])
  @@index([isActive, deletedAt])
  @@index([parentPatientId])
  @@index([createdAt])
  @@index([lastVisitAt])
  @@map("patients")
}

// ============================================================================
// SECTION 4: DOCTORS, EMPLOYEES & STAFF
// ============================================================================

model DoctorProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber     String   @unique
  specialtyAr       String
  specialtyEn       String?
  departmentId      String?  @db.Uuid
  department        Department? @relation(fields: [departmentId], references: [id])
  subSpecialty      String?
  consultationFee   Float?
  experience        Int?     // years
  education         String?
  certifications    String?
  bio               String?
  rating            Float    @default(0)
  totalRatings      Int      @default(0)
  consultationDuration Int  @default(15) // minutes
  acceptingPatients Boolean  @default(true)
  isConsultant      Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  schedule          DoctorSchedule[]
  appointments      Appointment[]
  issuedOrders      Order[]       @relation("IssuedByDoctor")

  @@index([licenseNumber])
  @@index([departmentId])
  @@index([specialtyAr])
  @@index([acceptingPatients])
  @@map("doctor_profiles")
}

model DoctorSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  doctorId      String   @db.Uuid
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branchId      String   @db.Uuid
  branch        Branch   @relation(fields: [branchId], references: [id])
  dayOfWeek     Int      // 0=Sunday, 6=Saturday
  startTime     String   // "09:00"
  endTime       String   // "17:00"
  slotDuration  Int      @default(15) // minutes
  maxPatients   Int      @default(20)
  isAvailable   Boolean  @default(true)
  breakStart    String?
  breakEnd      String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@unique([doctorId, branchId, dayOfWeek])
  @@index([doctorId])
  @@index([branchId, dayOfWeek])
  @@map("doctor_schedules")
}

model EmployeeProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNumber  String   @unique
  departmentId    String?  @db.Uuid
  department      Department? @relation(fields: [departmentId], references: [id])
  branchId        String?  @db.Uuid
  branch          Branch?  @relation(fields: [branchId], references: [id])
  positionAr      String
  positionEn      String?
  hireDate        DateTime @db.Date
  contractType    String   @default("full_time") // full_time, part_time, contract
  salary          Float?
  bankAccount     String?
  gosiNumber      String?
  emergencyContact String?
  emergencyPhone  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  payrollEntries  PayrollEntry[]

  @@index([employeeNumber])
  @@index([departmentId])
  @@index([branchId])
  @@index([isActive])
  @@map("employee_profiles")
}

model PhlebotomistProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification   String?
  maxDailyVisits  Int      @default(10)
  currentDailyCount Int    @default(0)
  assignedBranchId String? @db.Uuid
  assignedBranch  Branch?  @relation(fields: [assignedBranchId], references: [id])
  isAvailable     Boolean  @default(true)
  rating          Float    @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  homeVisits      HomeVisitRequest[]

  @@index([userId])
  @@index([isAvailable])
  @@map("phlebotomist_profiles")
}

// ============================================================================
// SECTION 5: BRANCHES & DEPARTMENTS
// ============================================================================

model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  nameAr          String
  nameEn          String
  code            String   @unique
  phone           String
  email           String?
  addressAr       String
  addressEn       String?
  city            String
  region          String
  country         String   @default("SA")
  latitude        Float?
  longitude       Float?
  timezone        String   @default("Asia/Riyadh")
  operatingHours  Json?
  maxCapacity     Int?
  isActive        Boolean  @default(true)
  managerId       String?  @db.Uuid
  manager         User?    @relation("BranchManager", fields: [managerId], references: [id])
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  orders          Order[]
  appointments    Appointment[]
  labTests        LabTest[]
  queueSettings   QueueSettings?
  queueEntries    QueueEntry[]
  queueServicePoints QueueServicePoint[]
  insuranceVerifications InsuranceVerification[]
  transfersFrom   BranchTransfer[] @relation("TransferFrom")
  transfersTo     BranchTransfer[] @relation("TransferTo")
  homeVisits      HomeVisitRequest[]
  emergencyCases  EmergencyCase[]
  barcodeJobs     BarcodePrintJob[]
  departments    Department[]
  receptionLogs   ReceptionAuditLog[]
  invoice         Invoice[]
  doctorSchedules DoctorSchedule[]
  employeeProfiles EmployeeProfile[]
  phlebotomistProfiles PhlebotomistProfile[]
  testBranchPricing TestBranchPricing[]

  @@index([code])
  @@index([city, region])
  @@index([isActive, deletedAt])
  @@index([managerId])
  @@map("branches")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  nameAr      String
  nameEn      String
  code        String   @unique
  description String?
  headId      String?  @db.Uuid
  branchId    String?  @db.Uuid
  branch      Branch?  @relation(fields: [branchId], references: [id])
  parentId    String?  @db.Uuid
  parent      Department? @relation("DeptTree", fields: [parentId], references: [id])
  children    Department[] @relation("DeptTree")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  budget      Float?
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  doctors     DoctorProfile[]
  employees   EmployeeProfile[]
  testCategories TestCategory[]

  @@index([code])
  @@index([branchId])
  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("departments")
}

// ============================================================================
// SECTION 6: LAB TESTS, CATEGORIES & PACKAGES
// ============================================================================

model TestCategory {
  id              String   @id @default(uuid()) @db.Uuid
  nameAr          String
  nameEn          String
  slug            String   @unique
  descriptionAr   String?
  descriptionEn   String?
  icon            String?
  color           String?
  departmentId    String?  @db.Uuid
  department      Department? @relation(fields: [departmentId], references: [id])
  parentId        String?  @db.Uuid
  parent          TestCategory? @relation("TestCategoryTree", fields: [parentId], references: [id])
  children        TestCategory[] @relation("TestCategoryTree")
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  subcategories   TestSubcategory[]
  labTests        LabTest[]
  testPackages    TestPackage[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("test_categories")
}

model TestSubcategory {
  id          String       @id @default(uuid()) @db.Uuid
  categoryId  String       @db.Uuid
  category    TestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameAr      String
  nameEn      String
  slug        String       @unique
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz
  deletedAt   DateTime?    @db.Timestamptz

  labTests    LabTest[]

  @@index([categoryId])
  @@index([isActive, deletedAt])
  @@map("test_subcategories")
}

model LabTest {
  id                  String          @id @default(uuid()) @db.Uuid
  nameAr              String
  nameEn              String
  code                String          @unique
  categoryId          String          @db.Uuid
  category            TestCategory    @relation(fields: [categoryId], references: [id])
  subcategoryId       String?         @db.Uuid
  subcategory         TestSubcategory? @relation(fields: [subcategoryId], references: [id])
  descriptionAr       String?
  descriptionEn       String?
  shortInfoAr         String?
  shortInfoEn         String?
  sampleType          String
  tubeType            String?
  tubeColor           String?
  fastingRequired     Boolean         @default(false)
  fastingHours        Int?
  turnaroundTimeHours Int             @default(24)
  price               Float
  discountedPrice     Float?
  currency            String          @default("SAR")
  referenceRange      Json?           // {male: {low, high}, female: {low, high}}
  units               String?
  methodology         String?
  homeCollection      Boolean         @default(true)
  popular             Boolean         @default(false)
  featured            Boolean         @default(false)
  sortOrder           Int             @default(0)
  isActive            Boolean         @default(true)
  preparationNotesAr  String?
  preparationNotesEn  String?
  clinicalSignificance String?
  metadata            Json?
  createdBy           String?         @db.Uuid
  updatedBy           String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz
  updatedAt           DateTime        @updatedAt @db.Timestamptz
  deletedAt           DateTime?       @db.Timestamptz

  branchId            String?         @db.Uuid
  branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderItems          OrderItem[]
  reportItems         ReportItem[]
  samples             Sample[]
  branchPricing       TestBranchPricing[]
  packageItems        TestPackageItem[]

  @@index([code])
  @@index([categoryId, isActive])
  @@index([popular, featured])
  @@index([sampleType])
  @@index([isActive, deletedAt])
  @@index([nameAr])
  @@index([nameEn])
  @@map("lab_tests")
}

model TestBranchPricing {
  id              String   @id @default(uuid()) @db.Uuid
  labTestId       String   @db.Uuid
  labTest         LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  branchId        String   @db.Uuid
  branch          Branch   @relation(fields: [branchId], references: [id])
  price           Float
  discountedPrice Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@unique([labTestId, branchId])
  @@index([branchId])
  @@map("test_branch_pricing")
}

model TestPackage {
  id            String           @id @default(uuid()) @db.Uuid
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  categoryId    String?          @db.Uuid
  category      TestCategory?    @relation(fields: [categoryId], references: [id])
  originalPrice Float
  packagePrice  Float
  discount      Float            @default(0)
  discountType  String           @default("percentage") // percentage, fixed
  isPopular     Boolean          @default(false)
  isActive      Boolean          @default(true)
  usageCount    Int              @default(0)
  createdBy     String?          @db.Uuid
  updatedBy     String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz
  updatedAt     DateTime         @updatedAt @db.Timestamptz
  deletedAt     DateTime?        @db.Timestamptz

  items         TestPackageItem[]
  orderItems    OrderItem[]

  @@index([isActive, deletedAt])
  @@index([isPopular])
  @@map("test_packages")
}

model TestPackageItem {
  id          String      @id @default(uuid()) @db.Uuid
  packageId   String      @db.Uuid
  package     TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  labTestId   String      @db.Uuid
  labTest     LabTest     @relation(fields: [labTestId], references: [id])
  quantity    Int         @default(1)
  createdAt   DateTime    @default(now()) @db.Timestamptz

  @@unique([packageId, labTestId])
  @@index([packageId])
  @@map("test_package_items")
}

// ============================================================================
// SECTION 7: ORDERS, SAMPLES & RESULTS
// ============================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CollectionType {
  HOME_VISIT
  BRANCH_WALK_IN
  BRANCH_APPOINTMENT
}

enum OrderPriority {
  NORMAL
  URGENT
  STAT
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
  INSURANCE_PENDING
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  MADA
  STC_PAY
  APPLE_PAY
  GOOGLE_PAY
  TABBY
  TAMARA
  CASH
  INSURANCE
  BANK_TRANSFER
  WALLET
}

enum SampleStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  RECEIVED
  ACCEPTED
  REJECTED
  PROCESSING
  COMPLETED
}

model Order {
  id                    String          @id @default(uuid()) @db.Uuid
  orderNumber           String          @unique // ORD-2024000001
  patientId             String          @db.Uuid
  patient               Patient         @relation(fields: [patientId], references: [id])
  doctorId              String?         @db.Uuid
  doctor                User?           @relation("OrderedBy", fields: [doctorId], references: [id])
  issuedById            String?         @db.Uuid
  issuedByDoctor        DoctorProfile?  @relation("IssuedByDoctor", fields: [issuedById], references: [id], onDelete: SetNull)
  branchId              String?         @db.Uuid
  branch                Branch?         @relation(fields: [branchId], references: [id])
  status                OrderStatus     @default(PENDING)
  collectionType        CollectionType  @default(BRANCH_WALK_IN)
  collectionDate        DateTime?       @db.Timestamptz
  collectionAddress     String?
  collectionLat         Float?
  collectionLng         Float?
  priority              OrderPriority   @default(NORMAL)
  subtotal              Float
  discount              Float           @default(0)
  discountType          String?         // percentage, fixed
  couponId              String?         @db.Uuid
  coupon                Coupon?         @relation(fields: [couponId], references: [id])
  tax                   Float           @default(0)
  taxRate               Float           @default(15) // ZATCA VAT
  total                 Float
  currency              String          @default("SAR")
  paymentStatus         PaymentStatus   @default(PENDING)
  paymentMethod         PaymentMethod?
  paymentReference      String?
  insuranceClaim        Boolean         @default(false)
  insuranceProvider     String?
  insuranceNumber       String?
  insuranceApprovalCode String?
  insuranceCoverage     Float?
  notes                 String?
  cancelReason          String?
  cancelReasonAr        String?
  completedAt           DateTime?       @db.Timestamptz
  createdBy             String?         @db.Uuid
  updatedBy             String?         @db.Uuid
  createdAt             DateTime        @default(now()) @db.Timestamptz
  updatedAt             DateTime        @updatedAt @db.Timestamptz
  deletedAt             DateTime?       @db.Timestamptz

  items                 OrderItem[]
  samples               Sample[]
  reports               Report[]
  appointment           Appointment?
  invoice               Invoice?
  refund                Refund?
  barcodeJobs           BarcodePrintJob[]
  notifications         Notification[]

  @@index([orderNumber])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([status])
  @@index([branchId, status])
  @@index([paymentStatus])
  @@index([doctorId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([priority])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labTestId   String?  @db.Uuid
  labTest     LabTest? @relation(fields: [labTestId], references: [id])
  packageId   String?  @db.Uuid
  package     TestPackage? @relation(fields: [packageId], references: [id])
  name        String   // Denormalized for fast display
  price       Float
  quantity    Int      @default(1)
  discount    Float    @default(0)
  total       Float
  notes       String?

  @@index([orderId])
  @@index([labTestId])
  @@map("order_items")
}

model Sample {
  id              String       @id @default(uuid()) @db.Uuid
  sampleCode      String       @unique // S-2024000001
  orderId         String       @db.Uuid
  order           Order        @relation(fields: [orderId], references: [id])
  labTestId       String       @db.Uuid
  labTest         LabTest      @relation(fields: [labTestId], references: [id])
  sampleType      String
  tubeType        String?
  tubeColor       String?
  quantity        Int          @default(1)
  status          SampleStatus @default(PENDING)
  collectedAt     DateTime?    @db.Timestamptz
  collectedById   String?      @db.Uuid
  receivedAt      DateTime?    @db.Timestamptz
  receivedById    String?      @db.Uuid
  rejectedAt      DateTime?    @db.Timestamptz
  rejectionReason String?
  temperature     Float?
  notes           String?
  qrCode          String?
  barcode         String?
  location        String?       // Physical storage location
  expiresAt       DateTime?     @db.Timestamptz
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  trackingEvents  SampleTrackingEvent[]

  @@index([sampleCode])
  @@index([orderId])
  @@index([status])
  @@index([collectedAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("samples")
}

model SampleTrackingEvent {
  id          String   @id @default(uuid()) @db.Uuid
  sampleId    String   @db.Uuid
  sample      Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  status      String   // From SampleStatus enum
  location    String?
  temperature Float?
  notes       String?
  performedById String? @db.Uuid
  performedAt DateTime @default(now()) @db.Timestamptz
  ipAddress   String?

  @@index([sampleId, performedAt])
  @@index([performedAt])
  @@map("sample_tracking_events")
}

enum ReportStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  RELEASED
  AMENDED
  CANCELLED
}

model Report {
  id              String        @id @default(uuid()) @db.Uuid
  reportNumber    String        @unique // RPT-2024000001
  orderId         String        @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id])
  patientId       String        @db.Uuid
  patient         Patient       @relation(fields: [patientId], references: [id])
  reviewedById    String?       @db.Uuid
  reviewer        User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedById    String?       @db.Uuid
  status          ReportStatus  @default(DRAFT)
  summary         String?
  conclusions     String?
  recommendations String?
  aiInsight       Json?
  aiConfidence    Float?
  pdfUrl          String?
  pdfSize         Int?
  digitalSignature String?
  signatureAlgorithm String?
  verifiedById    String?       @db.Uuid
  verifiedBy      User?         @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?     @db.Timestamptz
  releasedAt      DateTime?     @db.Timestamptz
  amendedAt       DateTime?     @db.Timestamptz
  amendReason     String?
  version         Int           @default(1)
  isCritical      Boolean       @default(false)
  viewCount       Int           @default(0)
  downloadCount   Int           @default(0)
  createdBy       String?       @db.Uuid
  updatedBy       String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz
  deletedAt       DateTime?     @db.Timestamptz

  items           ReportItem[]
  attachments     ResultAttachment[]

  @@index([reportNumber])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([releasedAt])
  @@map("reports")
}

model ReportItem {
  id                  String   @id @default(uuid()) @db.Uuid
  reportId            String   @db.Uuid
  report              Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  labTestId           String   @db.Uuid
  labTest             LabTest  @relation(fields: [labTestId], references: [id])
  value               String?
  numericValue        Float?
  unit                String?
  referenceRangeLow   Float?
  referenceRangeHigh  Float?
  referenceRangeText  String?
  isAbnormal          Boolean  @default(false)
  abnormalityType     String?  // high, low, critical_high, critical_low
  flags               String?  // H, L, HH, LL
  methodology         String?
  notes               String?
  displayOrder        Int      @default(0)

  @@index([reportId])
  @@index([labTestId])
  @@map("report_items")
}

model ResultAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @db.Uuid
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String   // image/png, application/pdf
  fileSize    Int
  description String?
  uploadedBy  String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([reportId])
  @@map("result_attachments")
}

