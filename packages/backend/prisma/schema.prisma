  deductions    Float         @default(0)
  gosiEmployee  Float         @default(0)
  gosiEmployer  Float         @default(0)
  tax           Float         @default(0)
  netPay        Float
  currency      String        @default("SAR")
  status        PayrollStatus @default(DRAFT)
  paidAt        DateTime?     @db.Timestamptz
  paymentMethod PaymentMethod?
  notes         String?
  createdBy     String?       @db.Uuid
  updatedBy     String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  @@unique([employeeId, period])
  @@index([period])
  @@index([status])
  @@index([createdAt])
  @@map("payroll_entries")
}

// ============================================================================
// SECTION 25: MARKETING & PARTNERS
// ============================================================================

model Partner {
  id              String   @id @default(uuid()) @db.Uuid
  nameAr          String
  nameEn          String
  type            String   // referral, corporate, insurance, government, pharmacy
  contactPerson   String
  email           String?
  phone           String?
  totalReferrals  Int      @default(0)
  totalRevenue    Float    @default(0)
  commission      Float    @default(0)
  commissionType  String   @default("percentage")
  status          String   @default("active") // active, inactive, pending
  contractStart   DateTime? @db.Date
  contractEnd     DateTime? @db.Date
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("partners")
}

model MarketingCampaign {
  id          String   @id @default(uuid()) @db.Uuid
  nameAr      String
  nameEn      String?
  type        String   // email, sms, social, ads, whatsapp
  status      String   @default("draft") // draft, active, paused, completed
  budget      Float    @default(0)
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  startDate   DateTime? @db.Timestamptz
  endDate     DateTime? @db.Timestamptz
  targetAudience Json?
  content     Json?
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  @@index([status])
  @@index([type])
  @@index([startDate, endDate])
  @@map("marketing_campaigns")
}

// ============================================================================
// SECTION 26: INVENTORY & SUPPLIERS
// ============================================================================

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  nameAr          String
  nameEn          String
  contactPerson   String
  email           String?
  phone           String?
  address         String?
  taxNumber       String?
  paymentTerms    Int      @default(30) // days
  rating          Float    @default(0)
  isActive        Boolean  @default(true)
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  inventoryItems  InventoryItem[]

  @@index([isActive, deletedAt])
  @@map("suppliers")
}

model InventoryItem {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique
  nameAr        String
  nameEn        String
  category      String   // reagents, consumables, equipment, supplies
  description   String?
  unit          String   @default("piece")
  quantity      Int      @default(0)
  minQuantity   Int      @default(10)
  maxQuantity   Int      @default(1000)
  reorderPoint  Int      @default(20)
  unitPrice     Float
  currency      String   @default("SAR")
  supplierId    String?  @db.Uuid
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  location      String?  // Physical storage location
  expiryDate    DateTime? @db.Date
  batchNumber   String?
  isActive      Boolean  @default(true)
  createdBy     String?  @db.Uuid
  updatedBy     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz

  movements     InventoryMovement[]

  @@index([sku])
  @@index([category])
  @@index([supplierId])
  @@index([expiryDate])
  @@index([quantity, reorderPoint])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  itemId        String   @db.Uuid
  item          InventoryItem @relation(fields: [itemId], references: [id])
  type          String   // in, out, adjustment, transfer
  quantity      Int
  fromLocation  String?
  toLocation    String?
  referenceType String?  // order, purchase_order, adjustment
  referenceId   String?
  notes         String?
  performedById String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz

  @@index([itemId, createdAt(sort: Desc)])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ============================================================================
// SECTION 20: AI ASSISTANT — Conversations, Knowledge Base, Analytics
// ============================================================================

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
  RESOLVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiModelProvider {
  OPENAI
  AZURE_OPENAI
  GEMINI
  CLAUDE
}

enum AiDocumentType {
  FAQ
  LAB_TEST_INFO
  RESULT_EXPLANATION
  PREPARATION_GUIDE
  HEALTH_PACKAGE
  MEDICAL_ARTICLE
  POLICY
  PROCEDURE
}

enum AiFeedbackRating {
  THUMBS_UP
  THUMBS_DOWN
  HELPFUL
  NOT_HELPFUL
  ACCURATE
  INACCURATE
}

model AiConversation {
  id            String                  @id @default(uuid()) @db.Uuid
  userId        String                  @db.Uuid
  userRole      String                  // PATIENT, DOCTOR, LAB_TECHNICIAN, RECEPTIONIST, ADMIN
  title         String?
  language      String                  @default("ar") // ar, en
  status        AiConversationStatus    @default(ACTIVE)
  metadata      Json?                   @db.JsonB
  messageCount  Int                     @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime                @default(now()) @db.Timestamptz
  updatedAt     DateTime                @updatedAt @db.Timestamptz
  deletedAt     DateTime?               @db.Timestamptz

  messages      AiMessage[]
  analytics     AiAnalytics[]

  @@index([userId])
  @@index([userRole])
  @@index([status])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id              String            @id @default(uuid()) @db.Uuid
  conversationId  String            @db.Uuid
  role            AiMessageRole
  content         String            @db.Text
  contentAr       String?           @db.Text
  contentType     String            @default("text") // text, markdown, html
  tokensIn        Int               @default(0)
  tokensOut       Int               @default(0)
  model           String?
  provider        AiModelProvider?
  latencyMs       Int?
  metadata        Json?             @db.JsonB
  toolCalls       Json?             @db.JsonB
  toolResults     Json?             @db.JsonB
  referencedDocs  String[]          // IDs of referenced knowledge base docs
  feedback        AiFeedbackRating?
  feedbackComment String?           @db.Text
  createdAt       DateTime          @default(now()) @db.Timestamptz

  conversation    AiConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedbacks       AiFeedback[]

  @@index([conversationId, createdAt])
  @@index([feedback])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiKnowledgeBase {
  id            String          @id @default(uuid()) @db.Uuid
  title         String
  titleAr       String?
  content       String          @db.Text
  contentAr     String?         @db.Text
  summary       String?         @db.Text
  summaryAr     String?         @db.Text
  documentType  AiDocumentType
  category      String?         // e.g., "hematology", "chemistry", "fasting"
  tags          String[]
  language      String          @default("both") // ar, en, both
  source        String?         // manual, import, generated
  sourceUrl     String?
  authorId      String?         @db.Uuid
  version       Int             @default(1)
  isActive      Boolean         @default(true)
  viewCount     Int             @default(0)
  helpfulCount  Int             @default(0)
  metadata      Json?           @db.JsonB
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz
  deletedAt     DateTime?       @db.Timestamptz

  chunks        AiKnowledgeChunk[]
  relatedFrom   AiKnowledgeRelation[] @relation("knowledge_from")
  relatedTo     AiKnowledgeRelation[] @relation("knowledge_to")

  @@index([documentType])
  @@index([category])
  @@index([tags])
  @@index([isActive])
  @@index([viewCount])
  @@index([createdAt])
  @@map("ai_knowledge_base")
}

model AiKnowledgeChunk {
  id              String    @id @default(uuid()) @db.Uuid
  knowledgeBaseId String    @db.Uuid
  content         String    @db.Text
  contentAr       String?   @db.Text
  chunkIndex      Int
  tokenCount      Int       @default(0)
  embedding       Unsupported("vector(1536)")?
  model           String?   // embedding model used
  createdAt       DateTime  @default(now()) @db.Timestamptz

  knowledgeBase   AiKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId, chunkIndex])
  @@map("ai_knowledge_chunks")
}

model AiKnowledgeRelation {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @db.Uuid
  targetId        String    @db.Uuid
  relationType    String    // "related", "prerequisite", "contraindication", "follow_up"
  weight          Float     @default(1.0)
  createdAt       DateTime  @default(now()) @db.Timestamptz

  source          AiKnowledgeBase @relation("knowledge_from", fields: [sourceId], references: [id], onDelete: Cascade)
  target          AiKnowledgeBase @relation("knowledge_to", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@index([relationType])
  @@map("ai_knowledge_relations")
}

model AiAnalytics {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String?   @db.Uuid
  userId          String?   @db.Uuid
  userRole        String?
  query           String    @db.Text
  queryLanguage   String    @default("ar")
  response        String?   @db.Text
  model           String?
  provider        AiModelProvider?
  latencyMs       Int?
  tokensIn        Int       @default(0)
  tokensOut       Int       @default(0)
  costUsd         Float     @default(0)
  documentType    AiDocumentType?
  retrievedDocs   Int       @default(0)
  rerankedDocs    Int       @default(0)
  hadKnowledge    Boolean   @default(false)
  feedbackRating  AiFeedbackRating?
  sessionDuration Int?      // seconds
  deviceType      String?   // web, mobile, voice
  ipAddress       String?
  userAgent       String?
  metadata        Json?     @db.JsonB
  createdAt       DateTime  @default(now()) @db.Timestamptz

  conversation    AiConversation? @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([userId])
  @@index([provider])
  @@index([model])
  @@index([documentType])
  @@index([feedbackRating])
  @@index([createdAt])
  @@index([createdAt, provider])
  @@index([createdAt, documentType])
  @@map("ai_analytics")
}

model AiFeedback {
  id              String            @id @default(uuid()) @db.Uuid
  messageId       String            @db.Uuid
  userId          String            @db.Uuid
  rating          AiFeedbackRating
  comment         String?           @db.Text
  category        String?           // accuracy, relevance, helpfulness, safety
  isResolved      Boolean           @default(false)
  resolvedById    String?           @db.Uuid
  resolvedAt      DateTime?         @db.Timestamptz
  createdAt       DateTime          @default(now()) @db.Timestamptz

  message         AiMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@map("ai_feedback")
}

// ============================================================================
// SECTION 21: CMS — Content Management System
// ============================================================================

model Author {
  id            String      @id @default(uuid()) @db.Uuid
  nameAr        String
  nameEn        String?
  email         String?
  bioAr         String?     @db.Text
  bioEn         String?     @db.Text
  avatar        String?
  specialization String?
  socialLinks   Json?       @db.JsonB // { twitter, linkedin, facebook, instagram }
  isActive      Boolean     @default(true)
  isLabStaff    Boolean     @default(false)
  userId        String?     @db.Uuid
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz
  deletedAt     DateTime?   @db.Timestamptz

  posts         BlogPost[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("authors")
}

model ContentCategory {
  id            String            @id @default(uuid()) @db.Uuid
  nameAr        String
  nameEn        String?
  slug          String            @unique
  descriptionAr String?           @db.Text
  descriptionEn String?           @db.Text
  icon          String?
  color         String?
  parentId      String?           @db.Uuid
  parent        ContentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      ContentCategory[] @relation("CategoryHierarchy")
  displayOrder  Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz
  deletedAt     DateTime?         @db.Timestamptz

  posts         BlogPost[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, displayOrder])
  @@map("content_categories")
}

model ContentRevision {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  version     Int
  titleAr     String?
  titleEn     String?
  contentAr   String?  @db.Text
  contentEn   String?  @db.Text
  excerptAr   String?  @db.Text
  excerptEn   String?  @db.Text
  slug        String?
  metaTitle   String?
  metaDescription String?
  ogTitle     String?
  ogDescription String?
  tags        String[]
  status      String   // snapshot of status at revision
  changeNotes String?  @db.Text
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([postId, version])
  @@index([createdAt])
  @@map("content_revisions")
}

model BlogPostRelation {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @db.Uuid
  targetId  String   @db.Uuid
  type      String   @default("related") // related, similar, series
  weight    Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  source    BlogPost @relation("relatedFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  target    BlogPost @relation("relatedTo", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@map("blog_post_relations")
}

model ContentComment {
  id            String          @id @default(uuid()) @db.Uuid
  postId        String          @db.Uuid
  post          BlogPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId      String?         @db.Uuid
  parent        ContentComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies       ContentComment[] @relation("CommentReplies")
  userId        String?         @db.Uuid
  authorName    String?         // for guest comments
  authorEmail   String?         // for guest comments
  content       String          @db.Text
  isApproved    Boolean         @default(false)
  isSpam        Boolean         @default(false)
  moderatedBy   String?         @db.Uuid
  moderatedAt   DateTime?       @db.Timestamptz
  likeCount     Int             @default(0)
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz
  deletedAt     DateTime?       @db.Timestamptz

  @@index([postId, isApproved])
  @@index([parentId])
  @@index([isSpam])
  @@index([createdAt])
  @@map("content_comments")
}

model ContentBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([postId, userId])
  @@index([userId])
  @@map("content_bookmarks")
}

model ContentLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([postId, userId])
  @@index([userId])
  @@map("content_likes")
}

model ContentAnalytics {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  shares      Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  bookmarks   Int      @default(0)
  avgReadTime Float?   // seconds
  source      String?  // direct, search, social, email, referral
  country     String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@unique([postId, date])
  @@index([postId, date(sort: Desc)])
  @@index([date])
  @@map("content_analytics")
}

model NewsletterSubscriber {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  nameAr        String?
  nameEn        String?
  language      String    @default("ar") // ar, en
  interests     String[]  // category slugs
  isActive      Boolean   @default(true)
  confirmedAt   DateTime? @db.Timestamptz
  unsubscribedAt DateTime? @db.Timestamptz
  unsubscribeReason String?
  source        String?   // website, blog, registration, admin
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([email])
  @@index([isActive])
  @@index([language])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id              String           @id @default(uuid()) @db.Uuid
  subjectAr       String
  subjectEn       String?
  previewTextAr   String?
  previewTextEn   String?
  contentAr       String?          @db.Text
  contentEn       String?          @db.Text
  templateId      String?          // reference to email template
  postIds         String[]         // linked blog posts
  categoryIds     String[]         // filter by categories
  language        String           @default("both") // ar, en, both
  status          String           @default("draft") // draft, scheduled, sending, sent, cancelled
  scheduledAt     DateTime?        @db.Timestamptz
  sentAt          DateTime?        @db.Timestamptz
  recipientCount  Int              @default(0)
  openCount       Int              @default(0)
  clickCount      Int              @default(0)
  bounceCount     Int              @default(0)
  unsubscribeCount Int             @default(0)
  createdBy       String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz
  deletedAt       DateTime?        @db.Timestamptz

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("newsletter_campaigns")
}
