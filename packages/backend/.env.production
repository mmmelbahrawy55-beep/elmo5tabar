# ============================================================================
# AL MOKHTABAR LABORATORY — PRODUCTION ENVIRONMENT
# ============================================================================

# App
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=https://almokhtabar.com

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://almokhtabar:${DB_PASSWORD}@postgres:5432/almokhtabar_production?schema=public&connection_limit=20&pool_timeout=30

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=${REDIS_PASSWORD}

# JWT
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
DATA_ENCRYPTION_KEY=${DATA_ENCRYPTION_KEY}

# OAuth - Google
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_REDIRECT_URI=https://almokhtabar.com/api/v1/auth/oauth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=${APPLE_CLIENT_ID}
APPLE_TEAM_ID=${APPLE_TEAM_ID}
APPLE_KEY_ID=${APPLE_KEY_ID}
APPLE_PRIVATE_KEY=${APPLE_PRIVATE_KEY}
APPLE_REDIRECT_URI=https://almokhtabar.com/api/v1/auth/oauth/apple/callback

# OAuth - Facebook
FACEBOOK_CLIENT_ID=${FACEBOOK_CLIENT_ID}
FACEBOOK_CLIENT_SECRET=${FACEBOOK_CLIENT_SECRET}
FACEBOOK_REDIRECT_URI=https://almokhtabar.com/api/v1/auth/oauth/facebook/callback

# SMS (Twilio)
SMS_PROVIDER=twilio
SMS_API_KEY=${TWILIO_ACCOUNT_SID}
SMS_API_SECRET=${TWILIO_AUTH_TOKEN}
SMS_SENDER_NUMBER=+966500000000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=noreply@almokhtabar.com

# MeiliSearch
MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
MEILI_HOST=http://meilisearch:7700

# Security
RATE_LIMIT_ENABLED=true
BRUTE_FORCE_ENABLED=true
CSRF_ENABLED=true
AUDIT_LOG_ENABLED=true
HIPAA_MODE=true
GDPR_MODE=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGINS=https://almokhtabar.com,https://www.almokhtabar.com
