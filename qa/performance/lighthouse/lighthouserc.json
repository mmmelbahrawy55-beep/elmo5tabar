{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "https://almokhtabar.com",
        "https://almokhtabar.com/ar/login",
        "https://almokhtabar.com/ar/appointments",
        "https://almokhtabar.com/ar/results",
        "https://almokhtabar.com/en/appointments"
      ],
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.95}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.95}],
        "first-contentful-paint": ["error", {"maxNumericValue": 1500}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["error", {"maxNumericValue": 200}],
        "interactive": ["error", {"maxNumericValue": 3500}],
        "speed-index": ["error", {"maxNumericValue": 3000}],
        "max-potential-fid": ["error", {"maxNumericValue": 100}],
        "uses-http2": ["error"],
        "uses-optimized-images": ["error"],
        "modern-image-formats": ["error"],
        "offscreen-images": ["error"],
        "render-blocking-resources": ["error", {"maxLength": 0}],
        "unused-javascript": ["warn", {"maxLength": 50}],
        "unused-css-rules": ["warn", {"maxLength": 25}],
        "uses-responsive-images": ["error"],
        "efficient-animated-content": ["error"],
        "uses-rel-preconnect": ["error"],
        "uses-rel-preload": ["warn"],
        "font-display": ["error"],
        "tap-targets": ["error"],
        "aria-allowed-attr": ["error"],
        "aria-required-children": ["error"],
        "aria-required-parent": ["error"],
        "aria-roles": ["error"],
        "aria-valid-attr-value": ["error"],
        "aria-valid-attr": ["error"],
        "button-name": ["error"],
        "color-contrast": ["error"],
        "definition-list": ["error"],
        "dl-item": ["error"],
        "document-title": ["error"],
        "duplicate-id-active": ["error"],
        "duplicate-id-aria": ["error"],
        "html-has-lang": ["error"],
        "html-lang-valid": ["error"],
        "image-alt": ["error"],
        "input-button-name": ["error"],
        "label": ["error"],
        "link-name": ["error"],
        "list": ["error"],
        "listitem": ["error"],
        "meta-viewport": ["error"],
        "object-alt": ["error"],
        "tabindex": ["error"],
        "td-headers-attr": ["error"],
        "th-has-data-cells": ["error"],
        "valid-lang": ["error"],
        "video-caption": ["error"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
