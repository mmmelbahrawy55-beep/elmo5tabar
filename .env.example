# Al Mokhtabar Laboratory Environment Variables
# ================================================
# Copy this file to .env and fill in the values

# App
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://al_mokhtabar:secure_password_2024@localhost:5432/al_mokhtabar
DB_PASSWORD=secure_password_2024

# Redis
REDIS_URL=redis://:redis_secure_2024@localhost:6379
REDIS_PASSWORD=redis_secure_2024

# JWT Authentication
JWT_SECRET=mokhtabar_jwt_secret_2024_production_key_change_me
JWT_REFRESH_SECRET=mokhtabar_refresh_secret_2024_production_key_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=meili_master_key_2024

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin2024
S3_BUCKET=al-mokhtabar-docs
S3_REGION=us-east-1

# SMS Provider (Unifonic for Saudi Arabia)
SMS_PROVIDER=unifonic
SMS_API_KEY=your_sms_api_key
SMS_SENDER=AlMokhtabar

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@almokhtabar.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Al Mokhtabar Lab <noreply@almokhtabar.com>"

# Push Notifications
FIREBASE_PROJECT_ID=al-mokhtabar-firebase
FIREBASE_PRIVATE_KEY=your_firebase_key
FIREBASE_CLIENT_EMAIL=firebase-admin@al-mokhtabar.iam.gserviceaccount.com

# AI Service
AI_SERVICE_URL=http://localhost:8001

# Payment Gateway (Tap Payments for Middle East)
TAP_SECRET_KEY=your_tap_secret_key
TAP_PUBLIC_KEY=your_tap_public_key

# Insurance Integration
NPHIES_URL=https://nphies.sa/api
NPHIES_API_KEY=your_nphies_key
CCHI_URL=https://cchi.sa/api
CCHI_API_KEY=your_cchi_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn

# Encryption
ENCRYPTION_KEY=32_char_encryption_key_here!!
